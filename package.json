{
  "name": "sprite",
  "version": "0.0.1",
  "description": "A CLI coding agent — an LLM in a loop with file tools.",
  "type": "module",
  "exports": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "sprite": "./bin/sprite.mjs"
  },
  "scripts": {
    "start": "tsx src/cli.tsx",
    "dev": "tsx watch src/cli.tsx",
    "typecheck": "tsc --noEmit",
    "probe": "tsx src/probe.ts",
    "test": "tsx --test src/tools.test.ts src/config.test.ts src/session.test.ts src/agent.test.ts src/completion.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.100.1",
    "chalk": "5.6.2",
    "ink": "7.0.3",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "6.0.0",
    "marked": "18.0.3",
    "react": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "25.9.0",
    "@types/react": "19.2.14",
    "tsx": "4.22.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
